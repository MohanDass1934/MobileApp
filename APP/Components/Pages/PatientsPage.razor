@page "/patients"

@using APP.Model
@using System.Net.Http.Json
@using System.Text.Json

<h3 class="mb-3">Patients</h3>

<EditForm Model="@patient" OnValidSubmit="Save">
    <div class="row g-2 mb-3">
        <div class="col-12 col-md-3">
            <input class="form-control" @bind="patient.PatientName" placeholder="Full Name" />
        </div>
        <div class="col-12 col-md-2">
            <input class="form-control" @bind="patient.MobileNo" placeholder="Phone" />
        </div>
        <div class="col-12 col-md-3">
            <input class="form-control" @bind="patient.Email" placeholder="Email" />
        </div>
        <div class="col-12 col-md-2">
            <input class="form-control" type="date" @bind="patient.DateOfBirth" />
        </div>
        <div class="col-12 col-md-2">
            <select class="form-select" @bind="patient.Gender">
                <option value="">Gender</option>
                <option value="male">Male</option>
                <option value="female">Female</option>
                <option value="other">Other</option>
            </select>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-3">
        <button class="btn btn-primary" type="submit">
            @(isEditing ? "Update" : "Save")
        </button>
        @if (isEditing)
        {
            <button class="btn btn-secondary" type="button" @onclick="CancelEdit">Cancel</button>
        }
    </div>
</EditForm>

@if (errorMessage != null)
{
    <div class="alert alert-danger mt-2">@errorMessage</div>
}

<hr />

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else if (list == null || list.Count == 0)
{
    <p><em>No patients found.</em></p>
}
else
{
    <!-- Desktop/Tablet view -->
    <div class="d-none d-md-block">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>DOB</th>
                    <th>Gender</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in list)
                {
                    <tr>
                        <td>@item.PatientName</td>
                        <td>@item.MobileNo</td>
                        <td>@item.Email</td>
                        <td>@(item.DateOfBirth?.ToString("yyyy-MM-dd"))</td>
                        <td>@item.Gender</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(item)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => Delete(item)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Mobile view (cards) -->
    <div class="d-block d-md-none">
        @foreach (var item in list)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">@item.PatientName</h5>
                    <div class="card-text">
                        <div class="mb-1">
                            <i class="bi bi-phone"></i> @item.MobileNo
                        </div>
                        <div class="mb-1">
                            <i class="bi bi-envelope"></i> @item.Email
                        </div>
                        <div class="mb-1">
                            <i class="bi bi-calendar"></i> @(item.DateOfBirth?.ToString("yyyy-MM-dd"))
                        </div>
                        <div class="mb-2">
                            <i class="bi bi-person"></i> @item.Gender
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary flex-grow-1" @onclick="() => Edit(item)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger flex-grow-1" @onclick="() => Delete(item)">Delete</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private static readonly JsonSerializerOptions JsonOpts = new()
    {
        PropertyNameCaseInsensitive = true
    };

    Patient patient = new();
    List<Patient> list = new();
    bool isEditing = false;
    bool isLoading = true;
    string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task LoadData()
    {

        isLoading = true;
        errorMessage = null;
        try
        {
            var response = await Http.GetFromJsonAsync<ApiListResponse<List<Patient>>>(
                "get_patients.php", JsonOpts);

            if (response is { Status: true })
                list = response.Data ?? new List<Patient>();
            else
                message.Error("Faild to load");
        }
        catch (Exception ex)
        {
            AlertService.ShowError("error loading", ex.Message);

        }
        finally
        {
            isLoading = false;
        }


    }

    void Edit(Patient item)
    {
        // Copy so the form doesn't mutate the list row until Save.
        patient = new Patient
        {
            PatientId = item.PatientId,
            PatientName = item.PatientName,
            MobileNo = item.MobileNo,
            Email = item.Email,
            DateOfBirth = item.DateOfBirth,
            Gender = item.Gender,
            Address = item.Address,
        };
        isEditing = true;
    }

    void CancelEdit()
    {
        patient = new();
        isEditing = false;
    }

    async Task Save()
    {
        errorMessage = null;
        try
        {
            HttpResponseMessage response = isEditing
                ? await Http.PostAsJsonAsync("update_patient.php", patient)
                : await Http.PostAsJsonAsync("add_patient.php", patient);

            if (response.IsSuccessStatusCode)
            {
                patient = new();
                isEditing = false;
                await LoadData();
            }
            else
            {
                AlertService.ShowWarning("Warnning",$"Save failed: {response.StatusCode}");
                errorMessage = $"Save failed: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            AlertService.ShowError("Error Saving Patient", ex.Message);
        }
    }

    async Task Delete(Patient item)
    {
        errorMessage = null;
        try
        {
            var response = await Http.PostAsJsonAsync("delete_patient.php", new { Id = item.PatientId });
            if (response.IsSuccessStatusCode)
                await LoadData();
            else
            AlertService.ShowWarning("Warnning",$"Delete failed: {response.StatusCode}");
        }
        catch (Exception ex)
        {
            AlertService.ShowError("Error Deleting Patient", ex.Message);
        }
    }
}