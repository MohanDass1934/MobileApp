@page "/add-patient"

@using APP.Model
@using System.Net.Http.Json
@using System.Text.Json
<h3 class="mb-3 text-center">Patient Registration</h3>

<EditForm Model="@patient" OnValidSubmit="Save">

    <div class="mb-3">
        <label class="form-label ">Full Name</label>
        <input class="form-control"
               @bind="patient.PatientName"
               placeholder="Enter Full Name" />
    </div>

    <div class="mb-3">
        <label class="form-label ">Mobile Number</label>
        <input class="form-control"
               @bind="patient.MobileNo"
               placeholder="Enter Mobile Number"
               type="tel" />
    </div>

    <div class="mb-3">
        <label class="form-label ">Email Address</label>
        <input class="form-control"
               @bind="patient.Email"
               placeholder="Enter Email Address"
               type="email" />
    </div>

    <div class="mb-3">
        <label class="form-label ">Date of Birth</label>
        <input class="form-control"
               type="date"
               @bind="patient.DateOfBirth" />
    </div>

    <div class="mb-4">
        <label class="form-label ">Gender</label>
        <select class="form-select" @bind="patient.Gender">
            <option value="">Select Gender</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
            <option value="Other">Other</option>
        </select>
    </div>

    <div class="d-grid gap-2">
        <button class="btn btn-primary" type="submit">
            @(isEditing ? "Update Patient" : "Save Patient")
        </button>

        @if (isEditing)
        {
            <button class="btn btn-outline-secondary "
                    type="button"
                    @onclick="CancelEdit">
                Cancel
            </button>
        }
    </div>

</EditForm>

