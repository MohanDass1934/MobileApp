@page "/counter"

<div class="booking-page">

    <div class="container py-5">
        <div class="row g-4">

            <!-- Doctor Profile Card -->
            <div class="col-lg-4">
                <div class="doctor-card">
                    <div class="doctor-banner"></div>
                    <div class="doctor-body text-center">
                        <div class="avatar-wrap">
                            <img src="images/doctor.png" class="avatar" />
                            <span class="status-dot" title="Available"></span>
                        </div>

                        <h3 class="doctor-name mt-3 mb-0">Dr. Maria Watson</h3>
                        <p class="doctor-role">Cardiac Surgeon</p>

                        <div class="rating">
                            @for (int i = 0; i < 5; i++)
                            {
                                <i class="bi bi-star-fill"></i>
                            }
                            <span class="rating-text">4.9 (500+ reviews)</span>
                        </div>

                        <div class="stats-row">
                            <div class="stat">
                                <h4>550+</h4>
                                <small>Patients</small>
                            </div>
                            <div class="stat divider"></div>
                            <div class="stat">
                                <h4>19+</h4>
                                <small>Years</small>
                            </div>
                            <div class="stat divider"></div>
                            <div class="stat">
                                <h4>500+</h4>
                                <small>Reviews</small>
                            </div>
                        </div>

                        <div class="tags">
                            <span class="tag"><i class="bi bi-heart-pulse"></i> Cardiology</span>
                            <span class="tag"><i class="bi bi-translate"></i> English, Hindi</span>
                        </div>

                        <div class="contact-box mt-3">
                            <div class="contact-item">
                                <i class="bi bi-geo-alt"></i> City Heart Hospital, Block A
                            </div>
                            <div class="contact-item">
                                <i class="bi bi-clock"></i> Mon - Sat, 09:00 - 15:00
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Booking Panel -->
            <div class="col-lg-8">
                <div class="booking-card">

                    <div class="section-header">
                        <div class="icon-badge"><i class="bi bi-calendar-check"></i></div>
                        <div>
                            <h4 class="mb-0">Select Date</h4>
                            <small class="text-muted">@SelectedDate.ToString("dddd, dd MMMM yyyy")</small>
                        </div>
                    </div>

                    <div class="date-scroll">
                        @foreach (var d in Dates)
                        {
                            <button class="date-chip @(SelectedDate.Date == d.Date ? "active" : "")"
                                    @onclick="() => SelectDate(d)">
                                <span class="dow">@d.ToString("ddd")</span>
                                <span class="dom">@d.ToString("dd")</span>
                                <span class="mon">@d.ToString("MMM")</span>
                            </button>
                        }
                    </div>

                    <hr class="section-divider" />

                    <div class="section-header">
                        <div class="icon-badge"><i class="bi bi-clock-history"></i></div>
                        <div>
                            <h4 class="mb-0">Available Time</h4>
                            <small class="text-muted">Slots shown in local time</small>
                        </div>
                    </div>

                    <div class="time-grid">
                        @foreach (var t in TimeSlots)
                        {
                            <button class="time-chip @(SelectedTime == t ? "active" : "")"
                                    @onclick="() => SelectedTime = t">
                                @t
                            </button>
                        }
                    </div>

                    <hr class="section-divider" />

                    <!-- Summary -->
                    <div class="summary-box">
                        <div class="summary-item">
                            <i class="bi bi-calendar-event"></i>
                            <div>
                                <small>Date</small>
                                <div class="fw-semibold">@SelectedDate.ToString("dd MMM yyyy")</div>
                            </div>
                        </div>
                        <div class="summary-item">
                            <i class="bi bi-alarm"></i>
                            <div>
                                <small>Time</small>
                                <div class="fw-semibold">@SelectedTime</div>
                            </div>
                        </div>
                        <div class="summary-item">
                            <i class="bi bi-cash-coin"></i>
                            <div>
                                <small>Fee</small>
                                <div class="fw-semibold">₹1,200</div>
                            </div>
                        </div>
                    </div>

                    <button class="btn-book" @onclick="BookAppointment">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        Confirm Appointment
                    </button>

                    @if (Confirmed)
                    {
                        <div class="confirm-toast">
                            <i class="bi bi-check-circle-fill"></i>
                            Appointment booked for @SelectedDate.ToString("dd MMM") at @SelectedTime
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    List<DateTime> Dates = Enumerable.Range(0, 10)
        .Select(x => DateTime.Today.AddDays(x))
        .ToList();

    List<string> TimeSlots = new()
    {
        "09:00", "09:30", "10:00", "10:30", "11:00",
        "11:30", "12:00", "02:00", "02:30", "03:00"
    };

    DateTime SelectedDate = DateTime.Today;
    string SelectedTime = "09:00";
    bool Confirmed = false;

    void SelectDate(DateTime d)
    {
        SelectedDate = d;
        Confirmed = false;
    }

    async void BookAppointment()
    {
        Console.WriteLine($"Date : {SelectedDate:d}");
        Console.WriteLine($"Time : {SelectedTime}");

        Confirmed = true;
        StateHasChanged();
        await Task.Delay(3500);
        Confirmed = false;
        StateHasChanged();
    }
}

<style>
