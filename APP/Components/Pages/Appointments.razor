@page "/appointments"

@using APP.Model
@using System.Net.Http.Json
@using System.Text.Json

<h3>Appointments</h3>

<EditForm Model="appointment" OnValidSubmit="Save">
    <div class="row g-2 mb-3">
        <div class="col-md-4 col-sm-6">
            <select class="form-control" @bind="appointment.PatientId">
                <option value="0">Select Patient</option>
                @foreach (var patient in patients)
                {
                    <option value="@patient.PatientId">@patient.PatientName</option>
                }
            </select>
        </div>
        <div class="col-md-4 col-sm-6">
            <select class="form-control" @bind="appointment.DentistId">
                <option value="0">Select Dentist</option>
                @foreach (var dentist in dentists)
                {
                    <option value="@dentist.DentistId">@dentist.FullName</option>
                }
            </select>
        </div>
        <div class="col-md-2 col-sm-6">
            <input class="form-control" type="date" @bind="appointment.AppointmentDate" required />
        </div>
        <div class="col-md-2 col-sm-6">
            <input class="form-control" type="time" @bind="appointment.AppointmentTime" required />
        </div>
        <div class="col-md-4 col-sm-6">
            <select class="form-control" @bind="appointment.Status">
                <option value="pending">Pending</option>
                <option value="confirmed">Confirmed</option>
                <option value="completed">Completed</option>
                <option value="cancelled">Cancelled</option>
                <option value="rescheduled">Rescheduled</option>
            </select>
        </div>
        <div class="col-md-8 col-sm-6">
            <input class="form-control" @bind="appointment.Notes" placeholder="Notes" />
        </div>
    </div>

    <button class="btn btn-primary" type="submit">
        @(isEditing ? "Update" : "Save")
    </button>
    @if (isEditing)
    {
        <button class="btn btn-secondary ms-2" type="button" @onclick="CancelEdit">Cancel</button>
    }
</EditForm>



<hr />

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else if (list == null || list.Count == 0)
{
    <p><em>No appointments found.</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>Dentist</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Status</th>
                    <th>Notes</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in list)
                {
                    <tr>
                        <td>@item.PatientName</td>
                        <td>@item.DentistName</td>
                        <td>@item.AppointmentDate.ToString("yyyy-MM-dd")</td>
                        <td>@item.AppointmentTime.ToString(@"hh\:mm")</td>
                        <td>
                            <span class="badge @(GetStatusBadgeClass(item.Status))">
                                @item.Status
                            </span>
                        </td>
                        <td>@item.Notes</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(item)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => Delete(item)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private static readonly JsonSerializerOptions JsonOpts = new()
    {
        PropertyNameCaseInsensitive = true
    };

    Appointment appointment = new();
    List<Appointment> list = new();
    List<Patient> patients = new();
    List<Dentist> dentists = new();
    bool isEditing = false;
    bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task LoadData()
    {
        isLoading = true;

        try
        {
            await LoadPatients();
        }
        catch (Exception ex)
        {
            AlertService.ShowError("Patients", ex.Message);
        }

        try
        {
            await LoadDentists();
        }
        catch (Exception ex)
        {
            AlertService.ShowError("Dentists", ex.Message);
        }

        try
        {
            await LoadAppointments();
        }
        catch (Exception ex)
        {
            AlertService.ShowError("Appointments", ex.Message);
        }

        isLoading = false;
    }

    async Task LoadPatients()
    {
        var response = await Http.GetFromJsonAsync<ApiListResponse<List<Patient>>>(
            "get_patients.php", JsonOpts);
        if (response is { Status: true })
            patients = response.Data ?? new List<Patient>();
    }

    async Task LoadDentists()
    {
        var response = await Http.GetFromJsonAsync<ApiListResponse<List<Dentist>>>(
            "get_dentists.php", JsonOpts);
        if (response is { Status: true })
            dentists = response.Data ?? new List<Dentist>();
    }

    async Task LoadAppointments()
    {
        var response = await Http.GetFromJsonAsync<ApiListResponse<List<Appointment>>>(
            "get_appointments.php", JsonOpts);
        if (response is { Status: true })
            list = response.Data ?? new List<Appointment>();
        else
            message.Warning(response?.Message ?? "Failed to load appointments.");
    }

    string GetStatusBadgeClass(string status)
    {
        return status.ToLower() switch
        {
            "pending" => "bg-warning text-dark",
            "confirmed" => "bg-info",
            "completed" => "bg-success",
            "cancelled" => "bg-danger",
            "rescheduled" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    void Edit(Appointment item)
    {
        appointment = new Appointment
        {
            AppointmentId = item.AppointmentId,
            PatientId = item.PatientId,
            DentistId = item.DentistId,
            AppointmentDate = item.AppointmentDate,
            AppointmentTime = item.AppointmentTime,
            Status = item.Status,
            Notes = item.Notes
        };
        isEditing = true;
    }

    void CancelEdit()
    {
        appointment = new Appointment { AppointmentDate = DateTime.Today };
        isEditing = false;
    }

    async Task Save()
    {
        try
        {
            HttpResponseMessage response = isEditing
                ? await Http.PostAsJsonAsync("update_appointment.php", appointment)
                : await Http.PostAsJsonAsync("add_appointment.php", appointment);

            if (response.IsSuccessStatusCode)
            {
                appointment = new Appointment { AppointmentDate = DateTime.Today };
                isEditing = false;
                await LoadData();
            }
            else
            {
                message.Warning($"Save failed: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            AlertService.ShowError($"Error saving appointment:", ex.Message);
        }
    }

    async Task Delete(Appointment item)
    {
        try
        {
            var response = await Http.PostAsJsonAsync("delete_appointment.php", new { Id = item.AppointmentId });
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ApiResponse>(JsonOpts);
                if (result is { Status: true })
                    await LoadData();
                else
                    message.Warning($"{result?.Message ?? "Delete failed"}");

            }
            else
            {
                message.Warning($"Delete failed: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            AlertService.ShowError($"Error deleting appointment:", ex.Message);
        }
    }

    public class ApiResponse
    {
        public bool Status { get; set; }
        public string? Message { get; set; }
    }

    public class ApiListResponse<T>
    {
        public bool Status { get; set; }
        public string? Message { get; set; }
        public T? Data { get; set; }
    }
}