@page "/patientoverview/{patientId:int}"
@using APP.Model
@using System.Net.Http.Json
@using System.Text.Json
<header class="app-header d-flex align-items-center justify-content-between px-3">
    <div class="brand d-flex align-items-center gap-2">
        <a class="back-btn" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <span>@(patient?.FullName ?? "Patient Not Found")</span>
            <div class="header-subtitle">Patient Overview</div>
        </div>
    </div>
    <div>
        <button class="btn btn-sm btn-primary" @onclick="EditPatient">
            <i class="bi bi-pencil"></i>
        </button>
        <button class="btn btn-sm btn-outline-danger" @onclick="DeletePatient">
            <i class="bi bi-trash"></i>
        </button>
    </div>
</header>

@if (isLoading)
{
    <div class="d-flex flex-column align-items-center justify-content-center py-5 text-muted">
        <div class="spinner-border text-primary mb-2" role="status" style="width:2.5rem;height:2.5rem;"></div>
        <span>Loading patient details...</span>
    </div>
}
else if (patient == null)
{
    <div class="text-center mt-5 text-muted">
        <i class="bi bi-person-x" style="font-size: 3rem; color: #c3ccd8;"></i>
        <h5 class="mt-2">Patient Not Found</h5>
        <p class="small">The patient you're looking for doesn't exist or has been removed.</p>
        <button class="btn btn-primary mt-2" @onclick="GoBack">Go Back</button>
    </div>
}
else
{

    <!-- Patient Profile Header -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex align-items-center gap-4">
                <div class="profile-avatar">
                    @if (!string.IsNullOrEmpty(patient.ProfilePhoto))
                    {
                        <img src="@patient.ProfilePhoto" alt="@patient.FullName" class="rounded-circle" style="width: 80px; height: 80px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="avatar-circle-large">
                            @GetInitials(patient.FullName)
                        </div>
                    }
                </div>
                <div class="flex-grow-1">
                    <h4 class="fw-bold mb-1" style="color: #0b1b33;">@patient.FullName</h4>
                    <div class="d-flex flex-wrap gap-3">
                        <span class="badge bg-primary">@patient.PatientCode</span>
                        <span class="text-muted"><i class="bi bi-telephone-fill me-1"></i>@patient.Phone</span>
                        @if (!string.IsNullOrEmpty(patient.Email))
                        {
                            <span class="text-muted"><i class="bi bi-envelope-fill me-1"></i>@patient.Email</span>
                        }
                        @if (!string.IsNullOrEmpty(patient.Gender))
                        {
                            <span class="text-muted"><i class="bi bi-gender-ambiguous me-1"></i>@patient.Gender</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <Tabs ActiveKey="1">
        <TabPane Key="1" Tab="Overview">
            <div class="row g-3">
                <!-- Personal Information -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-transparent border-0 pt-3 pb-0">
                            <h6 class="fw-bold mb-0" style="color: #0b1b33;">
                                <i class="bi bi-person-badge me-2"></i>Personal Information
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="detail-item">
                                <label class="text-muted small">Full Name</label>
                                <div class="fw-semibold">@patient.FullName</div>
                            </div>
                            <div class="detail-item">
                                <label class="text-muted small">Patient Code</label>
                                <div class="fw-semibold">@patient.PatientCode</div>
                            </div>
                            <div class="detail-item">
                                <label class="text-muted small">Date of Birth</label>
                                <div class="fw-semibold">@FormatDate(patient.DateOfBirth)</div>
                            </div>
                            @if (!string.IsNullOrEmpty(patient.Gender))
                            {
                                <div class="detail-item">
                                    <label class="text-muted small">Gender</label>
                                    <div class="fw-semibold">@patient.Gender</div>
                                </div>
                            }
                            <div class="detail-item">
                                <label class="text-muted small">Phone</label>
                                <div class="fw-semibold">@patient.Phone</div>
                            </div>
                            @if (!string.IsNullOrEmpty(patient.Email))
                            {
                                <div class="detail-item">
                                    <label class="text-muted small">Email</label>
                                    <div class="fw-semibold">@patient.Email</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(patient.Address))
                            {
                                <div class="detail-item">
                                    <label class="text-muted small">Address</label>
                                    <div class="fw-semibold">@patient.Address</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Medical & Emergency Information -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-transparent border-0 pt-3 pb-0">
                            <h6 class="fw-bold mb-0" style="color: #0b1b33;">
                                <i class="bi bi-info-circle me-2"></i>Medical & Emergency Information
                            </h6>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(patient.Allergies))
                            {
                                <div class="detail-item">
                                    <label class="text-muted small">Allergies</label>
                                    <div class="fw-semibold">@patient.Allergies</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(patient.MedicalHistory))
                            {
                                <div class="detail-item">
                                    <label class="text-muted small">Medical History</label>
                                    <div class="fw-semibold">@patient.MedicalHistory</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(patient.EmergencyContactName))
                            {
                                <div class="detail-item">
                                    <label class="text-muted small">Emergency Contact</label>
                                    <div class="fw-semibold">@patient.EmergencyContactName</div>
                                    @if (!string.IsNullOrEmpty(patient.EmergencyContactPhone))
                                    {
                                        <div class="small text-muted">@patient.EmergencyContactPhone</div>
                                    }
                                </div>
                            }
                            <div class="detail-item">
                                <label class="text-muted small">Created</label>
                                <div class="fw-semibold small">@FormatDateTime(patient.CreatedAt)</div>
                            </div>
                            <div class="detail-item">
                                <label class="text-muted small">Last Updated</label>
                                <div class="fw-semibold small">@FormatDateTime(patient.UpdatedAt)</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </TabPane>
        <TabPane Key="2" Tab="Medical History">

        </TabPane>
        <TabPane Key="3" Tab="Prescriptions">

        </TabPane>
        <TabPane Key="4" Tab="Payments">

        </TabPane>
    </Tabs>

    <!-- FAB WITH POPOVER - positioned next to button -->
    <div class="fab-wrapper">
        <Popover Placement="Placement.TopRight"
                 ContentTemplate="@_content"
                 Trigger="@(new[] { AntDesign.Trigger.Click })"
                 OverlayClassName="fab-popover">
            <a class="fab d-flex align-items-center justify-content-center" title="Add new">
                <i class="bi bi-plus-lg"></i>
            </a>
        </Popover>
    </div>
}


<style>
    .detail-item {
        padding: 0.5rem 0;
        border-bottom: 1px solid #f0f2f5;
    }

        .detail-item:last-child {
            border-bottom: none;
        }

    .profile-avatar {
        width: 80px;
        height: 80px;
        min-width: 80px;
    }

    .avatar-circle-large {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #2563eb, #1e40af);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 1.8rem;
        letter-spacing: 0.5px;
    }

    .badge {
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        font-weight: 500;
    }
    /* ----- FAB wrapper & popover positioning ----- */
    .fab-wrapper {
        position: fixed;
        bottom: calc(var(--nav-h) + 16px);
        right: 20px;
        z-index: 1070;
    }

    .fab {
        background: #0d6efd;
        color: white;
        width: var(--fab-size);
        height: var(--fab-size);
        border-radius: 50%;
        box-shadow: 0 10px 30px rgba(13,110,253,0.35);
        border: none;
        font-size: 1.75rem;
        transition: all 0.25s ease;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .fab:hover {
            transform: scale(1.05);
            background: #0b5ed7;
            box-shadow: 0 12px 32px rgba(13,110,253,0.4);
            color: white;
        }

        .fab:active {
            transform: scale(0.94);
        }

    /* Popover customization - position next to button */
    .fab-popover .ant-popover-inner {
        border-radius: 16px;
        box-shadow: 0 12px 40px rgba(0,0,0,0.12);
        min-width: 180px;
    }

    .fab-popover .ant-popover-arrow {
        display: none; /* Hide arrow for cleaner look */
    }

    .fab-popover .ant-popover-inner-content {
        padding: 8px 4px;
    }

    /* Popover menu items */
    .popover-menu-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 16px;
        border-radius: 10px;
        color: #1a2f4f;
        text-decoration: none;
        transition: all 0.15s ease;
        cursor: pointer;
        font-size: 0.95rem;
        font-weight: 500;
    }

        .popover-menu-item:hover {
            background: #e9f0ff;
            color: #0d6efd;
        }

        .popover-menu-item i {
            font-size: 1.2rem;
            color: #0d6efd;
            width: 24px;
            text-align: center;
        }

    /* responsive tweaks */
    @@media (max-width: 480px) {
        :root {
            --icon-size: 1.25rem;
            --fab-size: 52px;
        }

        .page-content {
            padding-left: 12px;
            padding-right: 12px;
        }

        .app-header .badge-dent {
            font-size: 0.7rem;
            padding: 4px 10px;
        }

        .nav-item-bottom {
            width: 40px;
            height: 40px;
        }

        .fab-wrapper {
            right: 14px;
        }

        .fab-popover .ant-popover-inner {
            min-width: 150px;
        }

        .popover-menu-item {
            padding: 8px 12px;
            font-size: 0.85rem;
        }

            .popover-menu-item i {
                font-size: 1rem;
                width: 20px;
            }
    }
</style>

@code {
    private RenderFragment _content = @<div>
        <a class="popover-menu-item" href="add-appointment">
            <i class="bi bi-calendar-plus"></i>
            Appointment
        </a>
        <a class="popover-menu-item" href="add-prescription">
            <i class="bi bi-file-medical"></i>
            Prescription
        </a>
        <a class="popover-menu-item" href="add-invoice">
            <i class="bi bi-receipt"></i>
            Invoice
        </a>
    </div>;

    [Parameter]
    public int PatientId { get; set; }

    private PatientDetail? patient;
    private bool isLoading = true;
    private static readonly JsonSerializerOptions JsonOpts = new()
    {
        PropertyNameCaseInsensitive = true
    };

    protected override async Task OnInitializedAsync()
    {

        await LoadPatientDetails();
    }

    async Task LoadPatientDetails()
    {
        isLoading = true;
        try
        {
            var response = await Http.GetFromJsonAsync<ApiListResponse<PatientDetail>>(
                $"get_patient.php?id={PatientId}", JsonOpts);
            patient = response is { Status: true } ? response.Data : null;

            // if (patient != null)
            // {
            //     HeaderService.Set(patient.FullName, "Patient Overview",
            //         showBack: true, backAction: GoBack);
            // }
            // else
            // {
            //     HeaderService.Set("Patient Not Found", showBack: true, backAction: GoBack);
            // }
        }
        finally
        {
            isLoading = false;
        }
    }

    string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }

    string FormatDate(DateTime? date)
    {
        return date?.ToString("MMMM dd, yyyy") ?? "N/A";
    }

    string FormatDateTime(DateTime? date)
    {
        return date?.ToString("MMMM dd, yyyy HH:mm") ?? "N/A";
    }

    void GoBack()
    {
        Navigation.NavigateTo("/patient");
    }

    void EditPatient()
    {
        Navigation.NavigateTo($"/patientedit/{PatientId}");
    }

    async Task DeletePatient()
    {
        bool res = await AlertService.ConfirmAsync("Confirm", "Sure want to delete!");
        if (res)
        {
            try
            {
                var response = await Http.DeleteAsync($"delete_patient.php?id={PatientId}");
                if (response.IsSuccessStatusCode)
                {
                    Navigation.NavigateTo("/patient");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting patient: {ex.Message}");
            }
        }
    }

    async Task<bool> ShowConfirmationDialog()
    {
        // Simple confirmation - you can replace with a proper modal
        return false;
    }
}